. ${ROOT_DIR}/${KERNEL_DIR}/build.config.common
. ${ROOT_DIR}/${KERNEL_DIR}/build.config.aarch64
. ${ROOT_DIR}/${KERNEL_DIR}/build.config.gki
. ${ROOT_DIR}/${KERNEL_DIR}/build.config.gki.aarch64

BUILD_SYSTEM_DLKM=0
BUILD_GKI_ARTIFACTS=0
BUILD_GKI_CERTIFICATION_TOOLS=0

# Override DEFCONFIG to use chickernel_defconfig as base
DEFCONFIG=chickernel_defconfig

# Apply CAKE/NTFS3 patch after make defconfig/olddefconfig
POST_DEFCONFIG_CMDS="apply_tuning_patch"

function apply_tuning_patch() {
  echo "=== Applying CAKE/NTFS3 tuning to .config ==="
  
  # Check if .config exists
  if [ ! -f "${OUT_DIR}/.config" ]; then
    echo "Error: .config not found at ${OUT_DIR}/.config"
    return 1
  fi
  
  # Find line numbers
  PRIO_LINE=$(grep -n "^CONFIG_NET_SCH_PRIO=" "${OUT_DIR}/.config" | tail -1 | cut -d: -f1)
  EXFAT_LINE=$(grep -n "^CONFIG_EXFAT_FS=" "${OUT_DIR}/.config" | tail -1 | cut -d: -f1)
  
  if [ -z "$PRIO_LINE" ] || [ -z "$EXFAT_LINE" ]; then
    echo "Error: Could not find required config symbols"
    echo "PRIO_LINE=$PRIO_LINE, EXFAT_LINE=$EXFAT_LINE"
    return 1
  fi
  
  echo "Found CONFIG_NET_SCH_PRIO at line $PRIO_LINE"
  echo "Found CONFIG_EXFAT_FS at line $EXFAT_LINE"
  
  # Insert CAKE after CONFIG_NET_SCH_PRIO
  sed -i "${PRIO_LINE}a\\# Tuning: CAKE AQM\\nCONFIG_NET_SCH_CAKE=y" "${OUT_DIR}/.config"
  
  # Recalculate line after first insert, then insert NTFS3
  EXFAT_LINE_NEW=$(grep -n "^CONFIG_EXFAT_FS=" "${OUT_DIR}/.config" | tail -1 | cut -d: -f1)
  sed -i "${EXFAT_LINE_NEW}a\\# Tuning: NTFS3 filesystem\\nCONFIG_NTFS3_FS=y\\nCONFIG_NTFS3_LZX_XPRESS=y\\nCONFIG_NTFS3_FS_POSIX_ACL=y" "${OUT_DIR}/.config"
  
  echo "=== CAKE/NTFS3 tuning applied ==="
  grep -E "^CONFIG_NET_SCH_CAKE=|^CONFIG_NTFS3_FS=|^CONFIG_NTFS3_LZX_XPRESS=|^CONFIG_NTFS3_FS_POSIX_ACL=" "${OUT_DIR}/.config"
}
